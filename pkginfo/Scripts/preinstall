#!/bin/bash

PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH

for uninstall_script in \
    '/Applications/Karabiner-Elements.app/Contents/Resources/uninstall_core.sh' \
    '/Library/Application Support/org.pqrs/Karabiner-Elements/uninstall_core.sh'; do
    if [ -f "$uninstall_script" ]; then
        sh "$uninstall_script"
        break
    fi
done

exit 0
