#!/bin/bash

PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH

#
# Create karabiner_machine_identifier
#

if [ ! -f '/Library/Application Support/org.pqrs/tmp/karabiner_machine_identifier.json' ]; then
    mkdir -p -m 0755 '/Library/Application Support/org.pqrs/tmp'
    chmod 0755 '/Library/Application Support/org.pqrs/tmp'

    echo "{\"karabiner_machine_identifier\": \"krbn-$(uuidgen | tr '[:upper:]' '[:lower:]')\"}" |
        tee '/Library/Application Support/org.pqrs/tmp/karabiner_machine_identifier.json'
    chmod 0644 '/Library/Application Support/org.pqrs/tmp/karabiner_machine_identifier.json'
fi

#
# Set icon
#

'/Applications/Karabiner-Elements.app/Contents/Helpers/Karabiner-AppIconSwitcher.app/Contents/MacOS/Karabiner-AppIconSwitcher'

#
# Relaunch launchd-managed processes after all files have been updated
#

# The v3 daemons use new labels. Stop and disable the old jobs so registrations
# owned by an older service manager cannot keep running after its app is removed.
for service_name in \
    org.pqrs.service.daemon.Karabiner-Core-Service \
    org.pqrs.service.daemon.Karabiner-VirtualHIDDevice-Daemon; do
    launchctl bootout "system/$service_name"
    launchctl disable "system/$service_name"
done

# On macOS 13, SIGTERM may leave some processes running.
killall -KILL Karabiner-Core-Service
killall -KILL Karabiner-VirtualHIDDevice-Daemon
killall -KILL Karabiner-Console-User-Server
killall -KILL Karabiner-Elements
killall -KILL Karabiner-EventViewer
killall -KILL Karabiner-MultitouchExtension

# Terminate deprecated processes as well, since they may have been running before the update.
killall -KILL karabiner_console_user_server
killall -KILL karabiner_grabber
killall -KILL karabiner_session_monitor
killall -KILL Karabiner-Menu
killall -KILL Karabiner-NotificationWindow

#
# Register launchd services from the newly installed application.
#

# SMAppService registration makes the services visible to launchd. The
# privileged daemons still require approval in System Settings before launchd
# can start them.
'/Applications/Karabiner-Elements.app/Contents/Helpers/Karabiner-Elements Privileged Daemons v3.app/Contents/MacOS/Karabiner-Elements Privileged Daemons v3' register-core-daemons
'/Applications/Karabiner-Elements.app/Contents/Helpers/Karabiner-Elements Non-Privileged Agents v3.app/Contents/MacOS/Karabiner-Elements Non-Privileged Agents v3' register-core-agents

exit 0
