#!/bin/bash

PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH

#
# Create karabiner_machine_identifier
#

if [ ! -f '/Library/Application Support/org.pqrs/tmp/karabiner_machine_identifier.json' ]; then
    mkdir -p -m 0755 '/Library/Application Support/org.pqrs/tmp'
    chmod 0755 '/Library/Application Support/org.pqrs/tmp'

    echo "{\"karabiner_machine_identifier\": \"krbn-$(uuidgen | tr '[:upper:]' '[:lower:]')\"}" |
        tee '/Library/Application Support/org.pqrs/tmp/karabiner_machine_identifier.json'
    chmod 0644 '/Library/Application Support/org.pqrs/tmp/karabiner_machine_identifier.json'
fi

#
# Relaunch launchd-managed processes after all files have been updated
#

# On macOS 13, SIGTERM may leave some processes running.
# Karabiner-VirtualHIDDevice-Daemon is handled by the DriverKit package's
# postinstall, which runs before this script.
killall -KILL Karabiner-Core-Service
killall -KILL Karabiner-Console-User-Server
killall -KILL Karabiner-Elements
killall -KILL Karabiner-EventViewer
killall -KILL Karabiner-MultitouchExtension

# Terminate deprecated processes as well, since they may have been running before the update.
killall -KILL karabiner_console_user_server
killall -KILL karabiner_grabber
killall -KILL karabiner_session_monitor
killall -KILL Karabiner-Menu
killall -KILL Karabiner-NotificationWindow

#
# Register services from the logged-in user's context.
#

# Package scripts run as root, but SMAppService LaunchAgents must be registered
# from the logged-in user's context. The behavior differs depending on whether
# the installer is launched from Installer.app or through Sparkle:
#
# - When the pkg was opened in Installer.app, PackageKit reported Installer.app
#   as responsible_path, and direct registration from postinstall happened to
#   succeed with "Successfully registered LaunchAgent(...)".
# - During a Sparkle update, PackageKit reported Sparkle's Autoupdate as
#   responsible_path. Launch Services registration and LaunchDaemon registration
#   succeeded. For LaunchAgents, unregister returned `Code=1 "Operation not
#   permitted"`, and every registration attempt returned `Code=3 "No such
#   process"`, including all retries.
#
# Therefore, do not register services directly from this root process. Instead,
# run the service managers in the console user's launchd bootstrap and with that
# user's uid. This registers the service manager bundles, LaunchDaemons, and
# LaunchAgents from a consistent user context.
#
# The commands are executed synchronously so their output is included in
# install.log. Their absolute paths point to the payload that was just installed,
# so this also works when Sparkle's older updater initiated the update. If there
# is no logged-in GUI user, skip this step; the normal Settings Window startup
# path will register the services when a user launches Karabiner-Elements later.
console_user=$(stat -f '%Su' /dev/console)
if [ "$console_user" != 'root' ] && [ "$console_user" != 'loginwindow' ]; then
    console_uid=$(id -u "$console_user")
    privileged_daemons_service_manager='/Applications/Karabiner-Elements.app/Contents/Helpers/Karabiner-Elements Privileged Daemons v3.app/Contents/MacOS/Karabiner-Elements Privileged Daemons v3'
    non_privileged_agents_service_manager='/Applications/Karabiner-Elements.app/Contents/Helpers/Karabiner-Elements Non-Privileged Agents v3.app/Contents/MacOS/Karabiner-Elements Non-Privileged Agents v3'

    echo "Registering services in console user context (uid: $console_uid)"

    launchctl asuser "$console_uid" sudo -u "$console_user" \
        "$privileged_daemons_service_manager" register-bundle
    launchctl asuser "$console_uid" sudo -u "$console_user" \
        "$non_privileged_agents_service_manager" register-bundle
    launchctl asuser "$console_uid" sudo -u "$console_user" \
        "$privileged_daemons_service_manager" register-core-daemons
    launchctl asuser "$console_uid" sudo -u "$console_user" \
        "$non_privileged_agents_service_manager" register-core-agents
else
    echo 'Skipping service registration because no logged-in GUI user was found'
fi

exit 0
