// Mouse motion: sampling windows and totals are independent per device
[
    // Device 1 starts a window with 1, below threshold 2.
    {
        "device_id": 1,
        "event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 1,
                "y": 0,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "event_time_stamp": {
            "time_stamp": 100
        },
        "event_type": "single",
        "lazy": false,
        "original_event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 1,
                "y": 0,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "validity": true
    },
    // Device 2 independently reaches threshold; its deadline is 240ms.
    {
        "device_id": 2,
        "event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 2,
                "y": 0,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "event_time_stamp": {
            "time_stamp": 140
        },
        "event_type": "single",
        "lazy": false,
        "original_event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 2,
                "y": 0,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "validity": true
    },
    // Device 1 must not borrow device 2's delta to reach threshold.
    {
        "action": "invoke_dispatcher",
        "time_stamp": 200
    },
    // Only device 2 emits right_arrow.
    {
        "action": "invoke_dispatcher",
        "time_stamp": 240
    },
    // Both windows expire before the dispatcher runs: emit right (600ms) before left (640ms).
    // Device 1 reaches threshold with an earlier deadline of 600ms.
    {
        "device_id": 1,
        "event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 2,
                "y": 0,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "event_time_stamp": {
            "time_stamp": 500
        },
        "event_type": "single",
        "lazy": false,
        "original_event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 2,
                "y": 0,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "validity": true
    },
    // Device 2 reaches threshold in the opposite direction, due at 640ms.
    {
        "device_id": 2,
        "event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": -2,
                "y": 0,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "event_time_stamp": {
            "time_stamp": 540
        },
        "event_type": "single",
        "lazy": false,
        "original_event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": -2,
                "y": 0,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "validity": true
    },
    // Run both overdue windows together; preserve deadline order, not device map order.
    {
        "action": "invoke_dispatcher",
        "time_stamp": 800
    }
]
