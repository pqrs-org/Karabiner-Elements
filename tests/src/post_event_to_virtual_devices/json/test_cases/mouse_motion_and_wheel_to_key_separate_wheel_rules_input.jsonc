// Separate horizontal and vertical rules retain their own intervals
[
    // One report starts both rules; horizontal uses 40ms and vertical uses 80ms.
    {
        "device_id": 1,
        "event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 0,
                "y": 0,
                "vertical_wheel": 5,
                "horizontal_wheel": 5
            }
        },
        "event_time_stamp": {
            "time_stamp": 100
        },
        "event_type": "single",
        "lazy": false,
        "original_event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 0,
                "y": 0,
                "vertical_wheel": 5,
                "horizontal_wheel": 5
            }
        },
        "validity": true
    },
    // Only the horizontal rule is due: emit right_arrow.
    {
        "action": "invoke_dispatcher",
        "time_stamp": 140
    },
    // The vertical rule now emits up_arrow at its own deadline.
    {
        "action": "invoke_dispatcher",
        "time_stamp": 180
    }
]
