            "pointing_motion": {
                "x": 50,
                "y": 0,
                "vertical_wheel": 3,
                "horizontal_wheel": 0
            }
        },
        "validity": true
    },
    // Another device can start and emit during device 1's cooldown.
    {
        "device_id": 2,
        "event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 2,
                "y": 0,
                "vertical_wheel": 0,
