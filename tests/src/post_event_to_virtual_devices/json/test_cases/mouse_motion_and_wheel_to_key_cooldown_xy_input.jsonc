    // Emit at 120ms: cooldown lasts until 320ms.
    {
        "device_id": 1,
        "event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 2,
                "y": 0,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "event_time_stamp": {
            "time_stamp": 100
        },
        "event_type": "single",
        "lazy": false,
        "original_event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 2,
                "y": 0,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "validity": true
    },
    {
        "action": "invoke_dispatcher",
        "time_stamp": 120
    },
    // During cooldown consume xy, but pass the wheel component immediately.
    {
        "device_id": 1,
        "event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 50,
                "y": 0,
                "vertical_wheel": 3,
                "horizontal_wheel": 0
            }
        },
        "event_time_stamp": {
