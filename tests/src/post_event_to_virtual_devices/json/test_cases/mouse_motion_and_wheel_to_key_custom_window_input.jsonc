// Mouse motion: custom interval discards surplus and subthreshold totals
[
    // Threshold is 10: a delta of 100 still produces only one tap after 40ms.
    {
        "device_id": 1,
        "event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 100,
                "y": 0,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "event_time_stamp": {
            "time_stamp": 100
        },
        "event_type": "single",
        "lazy": false,
        "original_event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 100,
                "y": 0,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "validity": true
    },
    // Advance to 1ms before the custom deadline.
    {
        "action": "invoke_dispatcher",
        "time_stamp": 139
    },
    // Emit the single tap at 140ms and discard the surplus.
    {
        "action": "invoke_dispatcher",
        "time_stamp": 140
    },
    // A new window with 9 must not inherit the previous surplus.
    {
        "device_id": 1,
        "event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 9,
                "y": 0,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "event_time_stamp": {
            "time_stamp": 200
        },
        "event_type": "single",
        "lazy": false,
        "original_event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 9,
                "y": 0,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "validity": true
    },
    // Below threshold: discard 9 without output.
    {
        "action": "invoke_dispatcher",
        "time_stamp": 240
    },
    // This 1 must not combine with the discarded 9 from the preceding window.
    {
        "device_id": 1,
        "event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 1,
                "y": 0,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "event_time_stamp": {
            "time_stamp": 300
        },
        "event_type": "single",
        "lazy": false,
        "original_event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 1,
                "y": 0,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "validity": true
    },
    // Still below threshold: no output.
    {
        "action": "invoke_dispatcher",
        "time_stamp": 340
    },
    // Start a new window with 6, below threshold.
    {
        "device_id": 1,
        "event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 6,
                "y": 0,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "event_time_stamp": {
            "time_stamp": 400
        },
        "event_type": "single",
        "lazy": false,
        "original_event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 6,
                "y": 0,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "validity": true
    },
    // Add 4 within that window to reach exactly 10.
    {
        "device_id": 1,
        "event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 4,
                "y": 0,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "event_time_stamp": {
            "time_stamp": 420
        },
        "event_type": "single",
        "lazy": false,
        "original_event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 4,
                "y": 0,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "validity": true
    },
    // Emit one tap for the accumulated 6 + 4.
    {
        "action": "invoke_dispatcher",
        "time_stamp": 440
    }
]
