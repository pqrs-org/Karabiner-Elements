// Wheels share the initial modifier snapshot; the next window captures new modifiers
[
    // Horizontal motion starts the shared window with no modifiers held.
    {
        "device_id": 1,
        "event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 0,
                "y": 0,
                "vertical_wheel": 0,
                "horizontal_wheel": 3
            }
        },
        "event_time_stamp": {
            "time_stamp": 100
        },
        "event_type": "single",
        "lazy": false,
        "original_event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 0,
                "y": 0,
                "vertical_wheel": 0,
                "horizontal_wheel": 3
            }
        },
        "validity": true
    },
    // Press Shift after the snapshot has been captured.
    {
        "device_id": 9,
        "event": {
            "type": "momentary_switch_event",
            "momentary_switch_event": {
                "key_code": "left_shift"
            }
        },
        "event_time_stamp": {
            "time_stamp": 140
        },
        "event_type": "key_down",
        "lazy": false,
        "original_event": {
            "type": "momentary_switch_event",
            "momentary_switch_event": {
                "key_code": "left_shift"
            }
        },
        "validity": true
    },
    // Vertical motion joins the same window and must use the original modifier snapshot.
    {
        "device_id": 1,
        "event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 0,
                "y": 0,
                "vertical_wheel": 3,
                "horizontal_wheel": 0
            }
        },
        "event_time_stamp": {
            "time_stamp": 150
        },
        "event_type": "single",
        "lazy": false,
        "original_event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 0,
                "y": 0,
                "vertical_wheel": 3,
                "horizontal_wheel": 0
            }
        },
        "validity": true
    },
    // Emit right_arrow and up_arrow without Shift, then restore the physical Shift state.
    {
        "action": "invoke_dispatcher",
        "time_stamp": 200
    },
    // A new window now captures the held Shift.
    {
        "device_id": 1,
        "event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 0,
                "y": 0,
                "vertical_wheel": 0,
                "horizontal_wheel": 3
            }
        },
        "event_time_stamp": {
            "time_stamp": 300
        },
        "event_type": "single",
        "lazy": false,
        "original_event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 0,
                "y": 0,
                "vertical_wheel": 0,
                "horizontal_wheel": 3
            }
        },
        "validity": true
    },
    // Release Shift after capture; the pending output must retain it.
    {
        "device_id": 9,
        "event": {
            "type": "momentary_switch_event",
            "momentary_switch_event": {
                "key_code": "left_shift"
            }
        },
        "event_time_stamp": {
            "time_stamp": 350
        },
        "event_type": "key_up",
        "lazy": false,
        "original_event": {
            "type": "momentary_switch_event",
            "momentary_switch_event": {
                "key_code": "left_shift"
            }
        },
        "validity": true
    },
    // Emit Shift+right_arrow, then restore the released physical state.
    {
        "action": "invoke_dispatcher",
        "time_stamp": 400
    }
]
