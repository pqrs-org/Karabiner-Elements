// Wheels: signed accumulation cancels reversals and maps all four directions
[
    // Start with positive deltas on both wheel axes.
    {
        "device_id": 1,
        "event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 0,
                "y": 0,
                "vertical_wheel": 10,
                "horizontal_wheel": 10
            }
        },
        "event_time_stamp": {
            "time_stamp": 100
        },
        "event_type": "single",
        "lazy": false,
        "original_event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 0,
                "y": 0,
                "vertical_wheel": 10,
                "horizontal_wheel": 10
            }
        },
        "validity": true
    },
    // Reverse enough to leave horizontal=-3 and vertical=+3, exactly at threshold.
    {
        "device_id": 1,
        "event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 0,
                "y": 0,
                "vertical_wheel": -7,
                "horizontal_wheel": -13
            }
        },
        "event_time_stamp": {
            "time_stamp": 150
        },
        "event_type": "single",
        "lazy": false,
        "original_event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 0,
                "y": 0,
                "vertical_wheel": -7,
                "horizontal_wheel": -13
            }
        },
        "validity": true
    },
    // Emit left_arrow then up_arrow; positive vertical wheel means up.
    {
        "action": "invoke_dispatcher",
        "time_stamp": 200
    },
    // Start a fresh window with the same positive deltas.
    {
        "device_id": 1,
        "event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 0,
                "y": 0,
                "vertical_wheel": 10,
                "horizontal_wheel": 10
            }
        },
        "event_time_stamp": {
            "time_stamp": 300
        },
        "event_type": "single",
        "lazy": false,
        "original_event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 0,
                "y": 0,
                "vertical_wheel": 10,
                "horizontal_wheel": 10
            }
        },
        "validity": true
    },
    // Leave horizontal=+3 and vertical=-3 to test the opposite directions.
    {
        "device_id": 1,
        "event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 0,
                "y": 0,
                "vertical_wheel": -13,
                "horizontal_wheel": -7
            }
        },
        "event_time_stamp": {
            "time_stamp": 350
        },
        "event_type": "single",
        "lazy": false,
        "original_event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 0,
                "y": 0,
                "vertical_wheel": -13,
                "horizontal_wheel": -7
            }
        },
        "validity": true
    },
    // Emit right_arrow then down_arrow.
    {
        "action": "invoke_dispatcher",
        "time_stamp": 400
    },
    // Start another window to test complete cancellation.
    {
        "device_id": 1,
        "event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 0,
                "y": 0,
                "vertical_wheel": 10,
                "horizontal_wheel": 10
            }
        },
        "event_time_stamp": {
            "time_stamp": 500
        },
        "event_type": "single",
        "lazy": false,
        "original_event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 0,
                "y": 0,
                "vertical_wheel": 10,
                "horizontal_wheel": 10
            }
        },
        "validity": true
    },
    // Cancel both axes exactly with opposite deltas.
    {
        "device_id": 1,
        "event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 0,
                "y": 0,
                "vertical_wheel": -10,
                "horizontal_wheel": -10
            }
        },
        "event_time_stamp": {
            "time_stamp": 550
        },
        "event_type": "single",
        "lazy": false,
        "original_event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 0,
                "y": 0,
                "vertical_wheel": -10,
                "horizontal_wheel": -10
            }
        },
        "validity": true
    },
    // Zero totals must produce no arrow keys.
    {
        "action": "invoke_dispatcher",
        "time_stamp": 600
    }
]
