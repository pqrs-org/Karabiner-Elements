// Pointer and tilt have independent windows; vertical scrolling passes immediately
[
    // A single report starts xy and tilt windows; vertical scroll must pass immediately.
    // The xy vector selects right; negative horizontal wheel selects left.
    {
        "device_id": 1,
        "event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 20,
                "y": 2,
                "vertical_wheel": 3,
                "horizontal_wheel": -4
            }
        },
        "event_time_stamp": {
            "time_stamp": 100
        },
        "event_type": "single",
        "lazy": false,
        "original_event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 20,
                "y": 2,
                "vertical_wheel": 3,
                "horizontal_wheel": -4
            }
        },
        "validity": true
    },
    // Only the 50ms tilt window is due: emit left_arrow.
    {
        "action": "invoke_dispatcher",
        "time_stamp": 150
    },
    // The independent 100ms xy window now emits right_arrow.
    {
        "action": "invoke_dispatcher",
        "time_stamp": 200
    }
]
