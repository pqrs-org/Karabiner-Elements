// Wheel axis selection: vertical_wheel preserves pointer motion and the other wheel axis
[
    // Combine pointer motion, horizontal scroll, and vertical delta 1 (the default threshold).
    // Only vertical_wheel is consumed; x/y and horizontal_wheel pass immediately.
    {
        "device_id": 1,
        "event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 3,
                "y": 4,
                "vertical_wheel": 1,
                "horizontal_wheel": 20
            }
        },
        "event_time_stamp": {
            "time_stamp": 100
        },
        "event_type": "single",
        "lazy": false,
        "original_event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 3,
                "y": 4,
                "vertical_wheel": 1,
                "horizontal_wheel": 20
            }
        },
        "validity": true
    },
    // After the default 100ms, emit up_arrow for the consumed vertical delta.
    {
        "action": "invoke_dispatcher",
        "time_stamp": 200
    }
]
