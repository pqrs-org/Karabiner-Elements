// Output conditions are evaluated at the window deadline
[
    // Start left motion while enabled is unset; the to condition must not be frozen yet.
    {
        "device_id": 1,
        "event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": -20,
                "y": 0,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "event_time_stamp": {
            "time_stamp": 100
        },
        "event_type": "single",
        "lazy": false,
        "original_event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": -20,
                "y": 0,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "validity": true
    },
    // Make the output condition true before the deadline.
    {
        "device_id": 1,
        "event": {
            "type": "set_variable",
            "set_variable": {
                "name": "enabled",
                "value": 1
            }
        },
        "event_time_stamp": {
            "time_stamp": 150
        },
        "event_type": "key_down",
        "lazy": false,
        "original_event": {
            "type": "set_variable",
            "set_variable": {
                "name": "enabled",
                "value": 1
            }
        },
        "validity": true
    },
    // Evaluate the current condition and emit left_arrow.
    {
        "action": "invoke_dispatcher",
        "time_stamp": 200
    },
    // Start another left window while the output condition is true.
    {
        "device_id": 1,
        "event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": -20,
                "y": 0,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "event_time_stamp": {
            "time_stamp": 300
        },
        "event_type": "single",
        "lazy": false,
        "original_event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": -20,
                "y": 0,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "validity": true
    },
    // Make the output condition false before this window ends.
    {
        "device_id": 1,
        "event": {
            "type": "set_variable",
            "set_variable": {
                "name": "enabled",
                "value": 0
            }
        },
        "event_time_stamp": {
            "time_stamp": 350
        },
        "event_type": "key_down",
        "lazy": false,
        "original_event": {
            "type": "set_variable",
            "set_variable": {
                "name": "enabled",
                "value": 0
            }
        },
        "validity": true
    },
    // Re-evaluate at the deadline and suppress left_arrow.
    {
        "action": "invoke_dispatcher",
        "time_stamp": 400
    }
]
