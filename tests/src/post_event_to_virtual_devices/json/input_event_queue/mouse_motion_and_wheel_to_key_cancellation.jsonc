[
    // Disconnect cancels the old window; a new window must not fire at the old deadline.
    // Reach threshold and start a window due at 200ms.
    {
        "device_id": 1,
        "event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 0,
                "y": -20,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "event_time_stamp": {
            "time_stamp": 100
        },
        "event_type": "single",
        "lazy": false,
        "original_event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 0,
                "y": -20,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "validity": true
    },
    // Disconnect before the deadline: discard this device's pending motion.
    {
        "device_id": 1,
        "event": {
            "type": "device_ungrabbed"
        },
        "event_time_stamp": {
            "time_stamp": 150
        },
        "event_type": "single",
        "lazy": false,
        "original_event": {
            "type": "device_ungrabbed"
        },
        "validity": true
    },
    // Start a fresh window due at 260ms, independent of the canceled one.
    {
        "device_id": 1,
        "event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 0,
                "y": -20,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "event_time_stamp": {
            "time_stamp": 160
        },
        "event_type": "single",
        "lazy": false,
        "original_event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 0,
                "y": -20,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "validity": true
    },
    // The canceled deadline must produce no key.
    {
        "action": "invoke_dispatcher",
        "time_stamp": 200
    },
    // Only the new window emits up_arrow.
    {
        "action": "invoke_dispatcher",
        "time_stamp": 260
    },
    // Releasing all keys/buttons preserves the window and its original deadline.
    // Start another window due at 600ms.
    {
        "device_id": 1,
        "event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 0,
                "y": -20,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "event_time_stamp": {
            "time_stamp": 500
        },
        "event_type": "single",
        "lazy": false,
        "original_event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 0,
                "y": -20,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "validity": true
    },
    // An ordinary release notification must not cancel pending motion.
    {
        "device_id": 1,
        "event": {
            "type": "device_keys_and_pointing_buttons_are_released"
        },
        "event_time_stamp": {
            "time_stamp": 550
        },
        "event_type": "single",
        "lazy": false,
        "original_event": {
            "type": "device_keys_and_pointing_buttons_are_released"
        },
        "validity": true
    },
    // Accumulate into the existing window; do not move its deadline to 660ms.
    {
        "device_id": 1,
        "event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 0,
                "y": -20,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "event_time_stamp": {
            "time_stamp": 560
        },
        "event_type": "single",
        "lazy": false,
        "original_event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 0,
                "y": -20,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "validity": true
    },
    // Emit one up_arrow at the original deadline.
    {
        "action": "invoke_dispatcher",
        "time_stamp": 600
    },
    // No second tap may appear at the would-be restarted deadline.
    {
        "action": "invoke_dispatcher",
        "time_stamp": 660
    },
    // Configuration invalidation cancels the pending window.
    // Start a window that would emit at 1000ms.
    {
        "device_id": 1,
        "event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 0,
                "y": -20,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "event_time_stamp": {
            "time_stamp": 900
        },
        "event_type": "single",
        "lazy": false,
        "original_event": {
            "type": "pointing_motion",
            "pointing_motion": {
                "x": 0,
                "y": -20,
                "vertical_wheel": 0,
                "horizontal_wheel": 0
            }
        },
        "validity": true
    },
    // Advance time to invalidate the rule before its deadline.
    {
        "action": "invoke_dispatcher",
        "time_stamp": 950
    },
    // Simulate configuration reload invalidating the pending manipulator.
    {
        "action": "invalidate_manipulators"
    },
    // The invalidated window must produce no key.
    {
        "action": "invoke_dispatcher",
        "time_stamp": 1000
    }
]
